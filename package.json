{
  "name": "graktor-desktop",
  "version": "1.0.0",
  "description": "Graktor — installable Windows/macOS app. Loads the live Zendoria/Graktor admin app in a native window; every install talks straight to the live server, same as a browser, just packaged.",
  "main": "main.js",
  "author": "Zendoria Ventures",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zendoriaventures.graktor",
    "productName": "Graktor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Graktor"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
